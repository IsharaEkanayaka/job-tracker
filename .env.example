# Copy this file to .env and change what you need. .env is git-ignored.
# Anything you leave out uses the default shown here.

# DATABASE_URL=sqlite:///C:/path/to/jobs.db   (default: jobs.db in the project root)
# SCORE_THRESHOLD=5
# Extra title words to reject (added to the built-in list, QA/testing already included):
# EXCLUDE_KEYWORDS=intern,support

# --- ITPro.lk ---
# Leave the URL empty to turn this source off:  ITPRO_CATEGORY_URL=
# ITPRO_CATEGORY_URL=https://itpro.lk/jobs/software-engineering/
# Maximum number of category pages fetched per run.
# ITPRO_MAX_PAGES=30

# --- Rooster.jobs ---
# Leave the URL empty to turn this source off:  ROOSTER_API_URL=
# ROOSTER_API_URL=https://api.rooster.jobs/jobSearch/jobs/search
# ROOSTER_QUERY=software engineer,developer,backend,frontend,full stack,embedded,firmware,devops
# ROOSTER_COUNTRY=Sri Lanka
# ROOSTER_FILTERS={"country":"Sri Lanka"}
# The collector always requests the API's 20-job page size and downloads all pages.
